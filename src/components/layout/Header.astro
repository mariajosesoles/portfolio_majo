---
import type { SiteConfig } from "../../types/site";
import { LangSwitch } from "../ui/LangSwitch";
import { ThemeToggle } from "../ui/ThemeToggle";

interface Props {
	config: SiteConfig;
	integrated?: boolean;
}

const { config, integrated = false } = Astro.props;

const leftNavIds = ["experience", "work", "building"];
const rightNavIds = ["about", "contact"];
const leftNav = config.nav.filter((item) => leftNavIds.includes(item.id));
const rightNav = config.nav.filter((item) => rightNavIds.includes(item.id));
const homeHref = config.locale === "en" ? "/en/" : "/";
---

<header
	class:list={[
		integrated
			? "hero-integrated-header absolute inset-x-0 top-0 z-20 border-0 bg-transparent shadow-none backdrop-blur-none"
			: "sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md",
	]}
>
	<div class="mx-auto flex max-w-6xl items-center gap-4 px-6 py-4">
		<nav
			class:list={[
				"font-nav hidden min-w-0 flex-1 items-center gap-[clamp(1rem,2.5vw,1.75rem)] text-[clamp(0.8125rem,1.05vw,1rem)] font-bold uppercase tracking-wide md:flex",
				integrated ? "text-white/90" : "text-muted",
			]}
			aria-label={config.locale === "es" ? "Principal izquierda" : "Main left"}
		>
			{
				leftNav.map((item) => (
					<a
						href={`#${item.id}`}
						class:list={[integrated ? "hover:text-white" : "transition hover:text-text"]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<a
			href={homeHref}
			class="flex shrink-0 items-center justify-center"
			aria-label={config.name}
		>
			<img
				src="/brand/icon.png"
				alt="Mariajose Soles"
				width="77"
				height="69"
				class="h-11 w-auto max-w-[5rem] object-contain md:h-12"
			/>
		</a>

		<nav
			class:list={[
				"font-nav hidden min-w-0 flex-1 items-center justify-end gap-[clamp(1rem,2.5vw,1.75rem)] text-[clamp(0.8125rem,1.05vw,1rem)] font-bold uppercase tracking-wide md:flex",
				integrated ? "text-white/90" : "text-muted",
			]}
			aria-label={config.locale === "es" ? "Principal derecha" : "Main right"}
		>
			{
				rightNav.map((item) => (
					<a
						href={`#${item.id}`}
						class:list={[integrated ? "hover:text-white" : "transition hover:text-text"]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-2 md:ml-0">
			<ThemeToggle locale={config.locale} client:load />
			<LangSwitch locale={config.locale} client:load />
		</div>
	</div>
</header>
