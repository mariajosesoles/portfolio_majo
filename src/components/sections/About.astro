---
import type { SiteConfig } from "../../types/site";
import { AboutPortrait } from "./AboutPortrait";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
const portraitAlt =
	config.locale === "es"
		? "Retrato ilustrado 3D de Mariajose Soles"
		: "Stylized 3D portrait of Mariajose Soles";
---

<section id="about" class="py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-6 lg:max-w-7xl">
		<h2 class="mb-10 text-2xl font-bold md:mb-12 md:text-3xl">{config.sections.about}</h2>
		<div
			class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16 xl:gap-20"
		>
			<div
				id="about-animation-slot"
				class="about-animation-slot w-full max-w-md justify-self-center md:max-w-none md:justify-self-stretch"
				data-about-animation
			>
				<AboutPortrait alt={portraitAlt} client:visible />
			</div>

			<div class="about-copy min-w-0 space-y-4 md:pt-2 lg:max-w-xl lg:justify-self-end xl:max-w-2xl">
				{
					config.about.paragraphs.map((paragraph) => (
						<p class="text-base leading-relaxed text-muted md:text-lg">{paragraph}</p>
					))
				}
				<p class="pt-2 text-sm font-medium text-accent md:text-base">{config.about.languages}</p>
			</div>
		</div>
	</div>
</section>
