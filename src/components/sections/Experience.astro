---
import type { SiteConfig } from "../../types/site";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
---

<section id="experience" class="py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-6">
		<h2 class="mb-10 text-2xl font-bold md:text-3xl">{config.sections.experience}</h2>
		<article class="rounded-2xl border border-border bg-bg-elevated/50 p-6 md:p-8">
			<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
				<h3 class="text-xl font-semibold">{config.experience.company}</h3>
				<p class="text-sm text-muted">
					{config.experience.period} · {config.experience.location}
				</p>
			</div>
			<p class="mb-6 text-muted">{config.experience.intro}</p>
			<ul class="space-y-4">
				{
					config.experience.products.map((product) => (
						<li class="border-l-2 border-accent/50 pl-4">
							<p class="font-medium">
								{product.name}
								<span class="font-normal text-muted"> — {product.description}</span>
							</p>
							<p class="text-sm text-accent">{product.role}</p>
						</li>
					))
				}
			</ul>
		</article>
	</div>
</section>
