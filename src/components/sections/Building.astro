---
import type { SiteConfig } from "../../types/site";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
---

<section id="building" class="py-16 md:py-20">
	<div class="page-container">
		<h2 class="type-section-title mb-10">{config.sections.building}</h2>
		<div class="grid gap-4 md:grid-cols-2">
			{
				config.building.map((item) => (
					<article class="rounded-2xl border border-dashed border-border bg-bg-elevated/30 p-6">
						<div class="mb-2 flex items-center justify-between gap-2">
							<h3 class="type-h3">{item.name}</h3>
							<span class="type-caption rounded-full border border-border px-2 py-0.5 text-muted">
								{item.status}
							</span>
						</div>
						<p class="type-body text-muted">{item.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
