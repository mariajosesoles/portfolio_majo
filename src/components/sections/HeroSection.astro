---
import type { SiteConfig } from "../../types/site";
import Header from "../layout/Header.astro";
import { Hero } from "./Hero";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
---

<section id="hero" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden pb-12 pt-20 md:pb-16 md:pt-24">
	<Header config={config} integrated />
	<Hero config={config} client:load />
</section>
