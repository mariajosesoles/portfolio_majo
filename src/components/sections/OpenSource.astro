---
import type { SiteConfig } from "../../types/site";
import { StackIcons } from "../ui/StackIcons";

interface Props {
	config: SiteConfig;
}

const { config } = Astro.props;
const os = config.openSource;
---

<section id="opensource" class="py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-6">
		<h2 class="mb-10 text-2xl font-bold md:text-3xl">{config.sections.openSource}</h2>
		<article class="rounded-2xl border border-border bg-bg-elevated/50 p-6 md:p-8">
			<h3 class="mb-1 text-xl font-semibold">{os.title}</h3>
			<p class="mb-4 text-sm text-accent">{os.role}</p>
			<div class="mb-4">
				<StackIcons stack={os.stack} client:visible />
			</div>
			<p class="mb-3 text-sm leading-relaxed text-muted">{os.description}</p>
			{os.pr && <p class="text-xs font-medium text-accent-2">{os.pr}</p>}
		</article>
	</div>
</section>
