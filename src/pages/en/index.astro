---
import Layout from "../../components/layout/Layout.astro";
import About from "../../components/sections/About.astro";
import Building from "../../components/sections/Building.astro";
import Contact from "../../components/sections/Contact.astro";
import Experience from "../../components/sections/Experience.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import OpenSource from "../../components/sections/OpenSource.astro";
import { SelectedWork } from "../../components/sections/SelectedWork";
import { projectsEn } from "../../data/projects";
import { siteEn } from "../../data/site.en";
---

<Layout config={siteEn}>
	<HeroSection config={siteEn} />
	<Experience config={siteEn} />
	<SelectedWork config={siteEn} projects={projectsEn} client:load />
	<OpenSource config={siteEn} />
	<Building config={siteEn} />
	<About config={siteEn} />
	<Contact config={siteEn} />
</Layout>
